APP_ENV=development
# Required: a NEW empty local PostgreSQL database owned by the organization.
DATABASE_URL=
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ADDITIONAL_ORIGINS=
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
TRUSTED_PROXY_CIDRS=
CLOCKIN_PROXY_SECRET=
# All mail/provider credentials must be supplied by the organization.
EMAIL_PROVIDER=smtp
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
